{
  "name": "chroma-lines",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:youtube": "PLATFORM=youtube vite build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "curve": "node --experimental-strip-types --no-warnings tools/build-curve.ts",
    "bench": "node --experimental-strip-types --no-warnings tools/bench.ts",
    "verify": "npm run check && npm test && npm run build"
  },
  "dependencies": {
    "@slu/web-shell": "file:vendor/slu-web-shell",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
